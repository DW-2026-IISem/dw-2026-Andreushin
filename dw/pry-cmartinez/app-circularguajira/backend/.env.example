NODE_ENV=development
PORT=3000

# Base de datos: motor dockerizado, consumido remotamente por IP del host.
# No se levanta el motor aquí. Dejar vacío hasta la Semana 05 (ver riesgos
# en docs/kanban.md); si se define DB_DIALECT, instalar antes el driver
# correspondiente (pg/pg-hstore, mysql2, tedious, etc.) en package.json.
DB_DIALECT=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT (RBAC no se implementa esta semana; variables reservadas)
JWT_SECRET=
JWT_EXPIRES_IN=1d
