# Copia este archivo a .env y completa los valores. El .env real nunca se versiona.
PORT=4000

# Motor de base de datos: mysql | postgres | mssql | oracle (el proyecto se prueba con mysql)
DB_ENGINE=mysql

MYSQL_HOST=localhost
MYSQL_USER=cg_express
MYSQL_PASSWORD=<contraseña>
MYSQL_NAME=circularguajira_express_db
MYSQL_PORT=3306

POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<contraseña>
POSTGRES_NAME=circularguajira_express_db
POSTGRES_PORT=5432

MSSQL_HOST=localhost
MSSQL_USER=sa
MSSQL_PASSWORD=<contraseña>
MSSQL_NAME=circularguajira_express_db
MSSQL_PORT=1433

ORACLE_HOST=localhost
ORACLE_USER=<usuario>
ORACLE_PASSWORD=<contraseña>
ORACLE_NAME=xe
ORACLE_PORT=1521

# Seguridad (JWT + RBAC)
# Secreto de firma del access token (HS256), mínimo 32 caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<secreto de al menos 32 caracteres>
# Vida útil del access token en segundos (900 = 15 min).
JWT_ACCESS_TTL=900
# Vida útil del refresh token en días (ventana deslizante: se reinicia en cada refresh).
JWT_REFRESH_TTL_DAYS=7
