@baseUrl = http://localhost:4000/api/recyclers
# JWT + RBAC: access token de un usuario con la concesión (401 sin token, 403 sin permiso).
@token = <access_token>

### PUT: reemplazo completo -> 200 (email y address omitidos quedan en null)
PUT {{baseUrl}}/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Yolanda Epiayú Ipuana",
  "documentNumber": "1124567890",
  "recyclerType": "independent",
  "phone": "3159876500"
}

### PUT: faltan campos obligatorios -> 400
PUT {{baseUrl}}/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Solo nombre"
}

### PATCH: cambio parcial (reactiva un reciclador inactivo) -> 200
PATCH {{baseUrl}}/3
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "active",
  "email": "luis.pushaina@correo.co"
}

### PATCH: documento de otro reciclador -> 409
PATCH {{baseUrl}}/3
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "documentNumber": "900123456-1"
}

### PATCH: cuerpo vacío -> 400
PATCH {{baseUrl}}/3
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### PATCH: id inexistente -> 404
PATCH {{baseUrl}}/9999
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phone": "3000000000"
}
