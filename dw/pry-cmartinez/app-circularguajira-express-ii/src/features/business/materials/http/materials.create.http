@baseUrl = http://localhost:4000/api/materials
# JWT + RBAC: access token de un usuario con la concesión (401 sin token, 403 sin permiso).
@token = <access_token>

### create: queda active por defecto -> 201
POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "PET",
  "description": "Botellas y envases plásticos transparentes"
}

### create: nombre repetido -> 409
POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "PET"
}

### create: sin nombre -> 400
POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Sin nombre"
}
