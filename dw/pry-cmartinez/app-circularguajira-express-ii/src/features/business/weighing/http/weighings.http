@baseUrl = http://localhost:4000/api
# JWT + RBAC: access token de un usuario con la concesión (401 sin token, 403 sin permiso).
@token = <access_token>

### create: agrega un pesaje a una recolección abierta -> 201
POST {{baseUrl}}/weighings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "collectionId": 1,
  "materialId": 7,
  "grossKg": 12,
  "tareKg": 0.5
}

### getAll / getOne
GET {{baseUrl}}/weighings
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/weighings/1
Authorization: Bearer {{token}}

### PATCH: nueva tara recalcula neto, importe y totales -> 200
PATCH {{baseUrl}}/weighings/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tareKg": 2.5
}

### PUT: ambos pesos -> 200
PUT {{baseUrl}}/weighings/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "grossKg": 51,
  "tareKg": 2.5
}

### deactivate (lógico) -> 200
PATCH {{baseUrl}}/weighings/3/deactivate
Authorization: Bearer {{token}}

### delete (físico) -> 200
DELETE {{baseUrl}}/weighings/3
Authorization: Bearer {{token}}
