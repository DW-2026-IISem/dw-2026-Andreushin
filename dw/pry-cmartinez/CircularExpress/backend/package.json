{
  "name": "backend",
  "version": "1.0.0",
  "description": "API REST para la gestión integral de la cadena de suministro de reciclaje en La Guajira (recicladores, rutas, puntos de acopio, pesajes, lotes de clasificación, ventas y liquidaciones).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
